# Local (défaut) : écriture directe dans Excel/ et data/ sous le projet
# DATA_BACKEND=file

# Vercel :
AUTH_SESSION_SECRET=change-me-to-a-long-random-string

# Token GitHub — NOM OBLIGATOIRE : HR_GITHUB_TOKEN
# (ne pas utiliser GITHUB_TOKEN — souvent en conflit / token révoqué)
# Fine-grained : repo Deonmass/HR-PPCB, Contents = Read and write
# Valeur sans guillemets, commence par github_pat_
# Puis Redeploy obligatoire
# HR_GITHUB_TOKEN=

# Optionnel
# GITHUB_REPOSITORY=Deonmass/HR-PPCB
# GITHUB_BRANCH=main
