# Local (défaut) : Excel/ et data/ sous le projet
# DATA_BACKEND=file

# Vercel : copies mutables sous /tmp (défini automatiquement si VERCEL=1)
# DATA_BACKEND=tmp
# DATA_DIR=/tmp/hr-rh-app

# Obligatoire sur Vercel pour signer les sessions
AUTH_SESSION_SECRET=change-me-to-a-long-random-string

# Obligatoire sur Vercel pour persister utilisateurs + permissions (et Params)
# Créez un Blob Store : Vercel → Storage → Blob → Connect to Project
# Puis copiez BLOB_READ_WRITE_TOKEN dans Environment Variables
# BLOB_READ_WRITE_TOKEN=

# Optionnel
# AUTH_STATELESS=1
# EMPLOYEE_XLSX=
# PROJECTS_XLSX=
# PARAMS_XLSX=
