# Local (défaut) : écriture directe dans Excel/ et data/ sous le projet
# DATA_BACKEND=file

# Vercel : le disque du déploiement est en lecture seule.
# Les utilisateurs / permissions sont donc synchronisés vers les fichiers
# du dépôt GitHub (Excel/Params.xlsx et data/auth/permissions.json).
#
# Obligatoire sur Vercel :
AUTH_SESSION_SECRET=change-me-to-a-long-random-string
#
# Token GitHub avec droit "Contents: Read and write" sur le dépôt
# (Settings → Developer settings → Personal access tokens)
# GITHUB_TOKEN=
#
# Optionnel (détectés automatiquement sur Vercel) :
# GITHUB_REPOSITORY=Deonmass/HR-PPCB
# GITHUB_BRANCH=main

# Optionnel
# AUTH_STATELESS=1
# DATA_BACKEND=tmp
# EMPLOYEE_XLSX=
# PROJECTS_XLSX=
# PARAMS_XLSX=
