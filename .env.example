# Local (défaut) : écriture directe dans Excel/ et data/ sous le projet
# DATA_BACKEND=file

# Vercel : le disque du déploiement est en lecture seule.
# Les utilisateurs / permissions sont synchronisés vers le dépôt GitHub
# (Excel/Params.xlsx et data/auth/permissions.json).
#
# Obligatoire sur Vercel :
AUTH_SESSION_SECRET=change-me-to-a-long-random-string
#
# Utilisez HR_GITHUB_TOKEN (évite les conflits avec le nom GITHUB_TOKEN).
# Fine-grained PAT : repo Deonmass/HR-PPCB, Contents = Read and write.
# Collez la valeur SANS guillemets, puis Redeploy.
# HR_GITHUB_TOKEN=
#
# Optionnel :
# GITHUB_REPOSITORY=Deonmass/HR-PPCB
# GITHUB_BRANCH=main
# AUTH_STATELESS=1
# DATA_BACKEND=tmp
# EMPLOYEE_XLSX=
# PROJECTS_XLSX=
# PARAMS_XLSX=
